git apply signout-badge.patchFrom 104ae0544880a01f1422f8a85a0e0769b10c8d5e Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 18 Sep 2026 06:47:35 +0000
Subject: [PATCH 1/2] Fix: sign out now actually clears local data/screen, not
 just the session
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Previously onAuthStateChange only updated the session variable — the old
user's data and current screen stayed exactly as they were, fully
navigable, even with no valid session. Now a SIGNED_OUT event wipes the
local cache, resets role, and bounces back to the Welcome screen.
---
 app/src/store.js | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/app/src/store.js b/app/src/store.js
index eb6a15c..1d9939d 100644
--- a/app/src/store.js
+++ b/app/src/store.js
@@ -69,8 +69,20 @@ export function useJourney() {
       setSession(s);
       setAuthLoading(false);
     });
-    const { data: sub } = supabase.auth.onAuthStateChange((_event, s) => {
+    const { data: sub } = supabase.auth.onAuthStateChange((event, s) => {
       setSession(s);
+      if (event === 'SIGNED_OUT') {
+        // Wipe the local cache and bounce back to Welcome — otherwise the
+        // previous session's data/screen would still be sitting there,
+        // fully navigable, even though there's no longer a valid session.
+        const d = blank();
+        persist(d);
+        setData(d);
+        setScreen('welcome');
+        setParams({});
+        setStack([]);
+        setRole('participant');
+      }
     });
     return () => sub.subscription.unsubscribe();
   }, []);
-- 
2.43.0


