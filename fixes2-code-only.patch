From: Claude <claude@anthropic.com>
Date: Sun, 13 Sep 2026 17:50:28 +0000
Subject: [PATCH] Remove redundant diagrams, shrink illustrations further, drop
 VisaQuestion image

- My Financial Map: remove code-drawn FinancialMapDiagram (redundant with real scale illustration), keep just the caption text
- VisaQuestion Assetland: remove illustration, back to standard layout (matches other terminals)
- ModuleIllustration: shrink default from 68%/260 to 56%/210
- Body as Your Vehicle illustration: shrink from 92%/340 to 72%/260
---
 app/src/components/ModuleIllustration.jsx | 2 +-
 app/src/screens/Module.jsx                | 7 ++++---
 app/src/screens/VisaQuestion.jsx          | 5 -----
 3 files changed, 5 insertions(+), 9 deletions(-)

diff --git a/app/src/components/ModuleIllustration.jsx b/app/src/components/ModuleIllustration.jsx
index 9be7e4a..fa1315c 100644
--- a/app/src/components/ModuleIllustration.jsx
+++ b/app/src/components/ModuleIllustration.jsx
@@ -1,7 +1,7 @@
 // A tinted, shaded card for module illustrations — matches the Terminal.jsx
 // header language (color tint + diagonal hatch) instead of a bare floating
 // image, and keeps the image modestly sized rather than edge-to-edge.
-export default function ModuleIllustration({ src, tc, maxWidth = 260, widthPct = '68%' }) {
+export default function ModuleIllustration({ src, tc, maxWidth = 210, widthPct = '56%' }) {
   return (
     <div
       style={{
diff --git a/app/src/screens/Module.jsx b/app/src/screens/Module.jsx
index 6de1343..dce9d4a 100644
--- a/app/src/screens/Module.jsx
+++ b/app/src/screens/Module.jsx
@@ -1,5 +1,4 @@
