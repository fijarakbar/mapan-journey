 app/src/screens/Module.jsx                |  9 ++++----
 app/src/screens/Terminal.jsx              |  4 ++--
 app/src/screens/Transition.jsx            |  8 +++++---
 app/src/screens/VisaQuestion.jsx          |  4 +++-
 app/src/screens/VisaStamp.jsx             |  2 +-
 app/src/screens/Welcome.jsx               |  4 +++-
 7 files changed, 43 insertions(+), 13 deletions(-)
 create mode 100644 app/src/components/ModuleIllustration.jsx

diff --git a/app/src/components/ModuleIllustration.jsx b/app/src/components/ModuleIllustration.jsx
new file mode 100644
index 0000000..9be7e4a
--- /dev/null
+++ b/app/src/components/ModuleIllustration.jsx
@@ -0,0 +1,25 @@
+// A tinted, shaded card for module illustrations — matches the Terminal.jsx
+// header language (color tint + diagonal hatch) instead of a bare floating
+// image, and keeps the image modestly sized rather than edge-to-edge.
+export default function ModuleIllustration({ src, tc, maxWidth = 260, widthPct = '68%' }) {
+  return (
+    <div
+      style={{
+        margin: '18px 0 0',
+        borderRadius: 20,
+        background: tc.tint,
+        border: `1px solid ${tc.border}`,
+        position: 'relative',
+        overflow: 'hidden',
+        padding: '16px 0',
+      }}
+    >
+      <div style={{ position: 'absolute', inset: 0, background: 'repeating-linear-gradient(120deg,rgba(255,255,255,.5) 0 10px,rgba(255,255,255,0) 10px 20px)' }} />
+      <img
+        src={src}
+        alt=""
+        style={{ position: 'relative', width: widthPct, maxWidth, height: 'auto', display: 'block', margin: '0 auto' }}
+      />
+    </div>
+  );
+}
