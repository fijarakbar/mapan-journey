From e98c73f3ad8e27ae2600d301d09bc0852611dc80 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sun, 13 Sep 2026 17:59:32 +0000
Subject: [PATCH] Add PWA manifest + app icons so it can be installed like a
 real app

- manifest.json with name, colors, and icon set (192/512, incl. maskable)
- App icon: mountain+sun mark on navy, matching brand colors
- index.html: manifest link, favicon, apple-touch-icon, theme-color meta
---
 app/index.html                      |   7 +++++++
 app/public/manifest.json            |  17 +++++++++++++++++
 app/public/pwa/apple-touch-icon.png | Bin 0 -> 2356 bytes
 app/public/pwa/favicon-32.png       | Bin 0 -> 494 bytes
 app/public/pwa/icon-192.png         | Bin 0 -> 2613 bytes
 app/public/pwa/icon-512.png         | Bin 0 -> 6834 bytes
 6 files changed, 24 insertions(+)
 create mode 100644 app/public/manifest.json
 create mode 100644 app/public/pwa/apple-touch-icon.png
 create mode 100644 app/public/pwa/favicon-32.png
 create mode 100644 app/public/pwa/icon-192.png
 create mode 100644 app/public/pwa/icon-512.png

diff --git a/app/index.html b/app/index.html
index 7499326..6b1b35b 100644
--- a/app/index.html
+++ b/app/index.html
@@ -4,6 +4,13 @@
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <title>MAPAN Journey</title>
+<link rel="manifest" href="/manifest.json">
+<link rel="icon" href="/pwa/favicon-32.png" sizes="32x32">
+<link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png">
+<meta name="theme-color" content="#10275A">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="apple-mobile-web-app-title" content="MAPAN">
 <link rel="preconnect" href="https://fonts.googleapis.com">
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
 <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
diff --git a/app/public/manifest.json b/app/public/manifest.json
new file mode 100644
index 0000000..2b134ac
--- /dev/null
+++ b/app/public/manifest.json
@@ -0,0 +1,17 @@
+{
+  "name": "MAPAN Journey",
+  "short_name": "MAPAN",
+  "description": "Menuju Purna Tugas Yang MAPAN.",
+  "start_url": "/",
+  "scope": "/",
+  "display": "standalone",
+  "orientation": "portrait",
+  "background_color": "#FBF9F5",
+  "theme_color": "#10275A",
+  "icons": [
+    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
+    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
+    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
+    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
+  ]
+}
