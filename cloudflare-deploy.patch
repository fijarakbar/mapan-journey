From ae9aedd07dc4eed55d40a4e03798a3813f5d6e90 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Sat, 12 Sep 2026 06:40:37 +0000
Subject: [PATCH] Add Cloudflare Workers deploy config (wrangler.jsonc + deploy
 script)

---
 app/.gitignore     | 6 +++---
 app/package.json   | 6 ++++--
 app/wrangler.jsonc | 8 ++++++++
 3 files changed, 15 insertions(+), 5 deletions(-)
 create mode 100644 app/wrangler.jsonc

diff --git a/app/.gitignore b/app/.gitignore
index 0ca39c0..d391312 100644
--- a/app/.gitignore
+++ b/app/.gitignore
@@ -1,3 +1,3 @@
-node_modules
-dist
-.DS_Store
+node_modules/
+dist/
+.wrangler/
diff --git a/app/package.json b/app/package.json
index 7ac2735..34c8e34 100644
--- a/app/package.json
+++ b/app/package.json
@@ -6,7 +6,8 @@
   "scripts": {
     "dev": "vite",
     "build": "vite build",
-    "preview": "vite preview"
+    "preview": "vite preview",
+    "deploy": "vite build && wrangler deploy"
   },
   "dependencies": {
     "react": "^18.3.1",
@@ -14,6 +15,7 @@
   },
   "devDependencies": {
     "@vitejs/plugin-react": "^4.3.4",
-    "vite": "^5.4.11"
+    "vite": "^5.4.11",
+    "wrangler": "^4.131.1"
   }
 }
diff --git a/app/wrangler.jsonc b/app/wrangler.jsonc
new file mode 100644
index 0000000..0d3aba5
--- /dev/null
+++ b/app/wrangler.jsonc
@@ -0,0 +1,8 @@
+{
+  "name": "mapan-journey",
+  "compatibility_date": "2026-09-12",
+  "assets": {
+    "directory": "./dist",
+    "not_found_handling": "single-page-application"
+  }
+}
-- 
2.43.0

